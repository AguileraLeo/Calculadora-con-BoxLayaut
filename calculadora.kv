#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# Botón numérico minimalista (Azul marino profundo suave)
<DarkButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.90, 0.94, 0.98, 1
    font_size: sp(20)
    bold: False
    canvas.before:
        Color:
            rgba: (0.12, 0.16, 0.23, 1) if self.state == "normal" else (0.18, 0.24, 0.35, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

# Botón de operador (Azul metálico/pizarra)
<OperatorButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.55, 0.75, 0.98, 1
    font_size: sp(20)
    bold: True
    canvas.before:
        Color:
            rgba: (0.15, 0.22, 0.33, 1) if self.state == "normal" else (0.22, 0.31, 0.45, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

# Botón de Igual (Azul vibrante aesthetic)
<EqualButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: sp(22)
    bold: True
    canvas.before:
        Color:
            rgba: (0.22, 0.48, 0.95, 1) if self.state == "normal" else (0.16, 0.38, 0.78, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

# Botón especial para Salir
<ExitButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.95, 0.45, 0.50, 1
    font_size: sp(15)
    bold: True
    canvas.before:
        Color:
            rgba: (0.22, 0.14, 0.18, 1) if self.state == "normal" else (0.32, 0.18, 0.22, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

# Botones secundarios planos y limpios
<SmallButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.70, 0.82, 0.95, 1
    font_size: sp(13)
    bold: False
    size_hint_y: None
    height: dp(36)
    canvas.before:
        Color:
            rgba: (0.12, 0.16, 0.23, 1) if self.state == "normal" else (0.18, 0.24, 0.35, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<PrimaryButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: sp(16)
    bold: True
    size_hint_y: None
    height: dp(50)
    canvas.before:
        Color:
            rgba: (0.22, 0.48, 0.95, 1) if self.state == "normal" else (0.16, 0.38, 0.78, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<PlanCard@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.92, 0.95, 0.98, 1
    font_size: sp(15)
    bold: False
    halign: "left"
    valign: "top"
    text_size: self.size
    padding: dp(18), dp(18)
    canvas.before:
        Color:
            rgba: (0.10, 0.14, 0.20, 1) if self.state == "normal" else (0.15, 0.20, 0.30, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: (0.18, 0.25, 0.36, 1) if self.state == "normal" else (0.22, 0.48, 0.95, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(1)


# =========================================================
# CALCULADORA
# =========================================================

<CalculadoraScreen>:

    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.12, 1  # Fondo Azul Marino Minimalista
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        # Encabezado
        BoxLayout:
            size_hint_y: None
            height: dp(32)

            Label:
                text: "CALCULADORA"
                color: 0.85, 0.90, 0.96, 1
                font_size: sp(18)
                bold: True
                halign: "left"
                text_size: self.size

            Label:
                text: "PRO"
                color: 0.22, 0.48, 0.95, 1
                font_size: sp(15)
                bold: True
                halign: "right"
                text_size: self.size

        # Barra superior de contador y botón Cambiar
        BoxLayout:
            size_hint_y: None
            height: dp(36)
            spacing: dp(10)

            Label:
                id: contador
                text: "FREE • 5 cálculos restantes"
                color: 0.45, 0.55, 0.68, 1
                font_size: sp(12)
                halign: "left"
                valign: "middle"
                text_size: self.size

            SmallButton:
                text: "Cambiar"
                size_hint_x: 0.35
                on_press: root.ir_a_formulario()

        # Display Pantalla Pantalla limpia
        BoxLayout:
            size_hint_y: 0.22
            padding: dp(20)

            canvas.before:
                Color:
                    rgba: 0.10, 0.13, 0.19, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16)]

            Label:
                id: display
                text: "0"
                color: 0.92, 0.96, 1, 1
                font_size: sp(40)
                bold: False
                halign: "right"
                valign: "middle"
                text_size: self.size

        # Rejilla del Teclado Principal (5x4)
        GridLayout:
            rows: 5
            cols: 4
            spacing: dp(10)

            # Fila 1
            OperatorButton:
                text: "C"
                on_press: root.presionar_boton(self)
            OperatorButton:
                text: "("
                on_press: root.presionar_boton(self)
            OperatorButton:
                text: ")"
                on_press: root.presionar_boton(self)
            OperatorButton:
                text: "÷"
                on_press: root.presionar_boton(self)

            # Fila 2
            DarkButton:
                text: "7"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "8"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "9"
                on_press: root.presionar_boton(self)
            OperatorButton:
                text: "×"
                on_press: root.presionar_boton(self)

            # Fila 3
            DarkButton:
                text: "4"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "5"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "6"
                on_press: root.presionar_boton(self)
            OperatorButton:
                text: "-"
                on_press: root.presionar_boton(self)

            # Fila 4
            DarkButton:
                text: "1"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "2"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "3"
                on_press: root.presionar_boton(self)
            OperatorButton:
                text: "+"
                on_press: root.presionar_boton(self)

            # Fila 5
            DarkButton:
                text: "0"
                on_press: root.presionar_boton(self)
            DarkButton:
                text: "."
                on_press: root.presionar_boton(self)
            EqualButton:
                text: "="
                on_press: root.presionar_boton(self)
            ExitButton:
                text: "Salir"
                on_press: root.presionar_boton(self)


# =========================================================
# FORMULARIO
# =========================================================

<FormularioScreen>:

    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        spacing: dp(16)
        padding: dp(28)

        Label:
            text: "SUMA RÁPIDA"
            color: 0.90, 0.94, 0.98, 1
            font_size: sp(28)
            bold: True
            size_hint_y: None
            height: dp(50)

        Label:
            text: "Una segunda interfaz usando BoxLayout"
            color: 0.45, 0.55, 0.68, 1
            font_size: sp(14)
            size_hint_y: None
            height: dp(30)

        TextInput:
            id: numero1
            hint_text: "Primer número"
            multiline: False
            input_filter: "float"
            font_size: sp(18)
            size_hint_y: None
            height: dp(54)
            padding: dp(16), dp(12)
            background_normal: ""
            background_active: ""
            background_color: 0.10, 0.13, 0.19, 1
            foreground_color: 0.92, 0.96, 1, 1
            hint_text_color: 0.38, 0.46, 0.58, 1

        TextInput:
            id: numero2
            hint_text: "Segundo número"
            multiline: False
            input_filter: "float"
            font_size: sp(18)
            size_hint_y: None
            height: dp(54)
            padding: dp(16), dp(12)
            background_normal: ""
            background_active: ""
            background_color: 0.10, 0.13, 0.19, 1
            foreground_color: 0.92, 0.96, 1, 1
            hint_text_color: 0.38, 0.46, 0.58, 1

        PrimaryButton:
            text: "CALCULAR SUMA"
            on_press: root.calcular_suma(self)

        Label:
            id: resultado
            text: "Resultado: 0"
            color: 0.55, 0.75, 0.98, 1
            font_size: sp(22)
            bold: True

        SmallButton:
            text: "Volver a calculadora"
            on_press: root.volver(self)


# =========================================================
# PREMIUM
# =========================================================

<PremiumScreen>:

    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:

        BoxLayout:
            orientation: "vertical"
            spacing: dp(16)
            padding: dp(28), dp(28)
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "CALCULADORA PRO"
                color: 0.90, 0.94, 0.98, 1
                font_size: sp(26)
                bold: True
                size_hint_y: None
                height: dp(45)
                halign: "left"
                text_size: self.size

            Label:
                text: "Más tiempo con tu calculadora"
                color: 0.45, 0.55, 0.68, 1
                font_size: sp(16)
                size_hint_y: None
                height: dp(35)
                halign: "left"
                text_size: self.size

            Label:
                text: "FREE TERMINADO"
                color: 0.22, 0.48, 0.95, 1
                font_size: sp(12)
                bold: True
                size_hint_y: None
                height: dp(25)
                halign: "left"
                text_size: self.size

            Label:
                text: "Has usado tus 5 cálculos gratuitos.\nLa calculadora necesita vacaciones."
                color: 0.70, 0.78, 0.88, 1
                font_size: sp(14)
                size_hint_y: None
                height: dp(50)
                halign: "left"
                text_size: self.size

            Label:
                text: "ELIGE TU PLAN"
                color: 0.38, 0.46, 0.58, 1
                font_size: sp(12)
                bold: True
                size_hint_y: None
                height: dp(25)
                halign: "left"
                text_size: self.size

            BoxLayout:
                orientation: "horizontal"
                spacing: dp(14)
                size_hint_y: None
                height: dp(180)

                PlanCard:
                    text: "INDIVIDUAL\n\n$2.990 / mes\n\nCálculos ilimitados"
                    on_press: root.seleccionar_plan("Individual")

                PlanCard:
                    text: "FAMILIAR\n\n$5.990 / mes\n\nHasta 5 calculadoras"
                    on_press: root.seleccionar_plan("Familiar")

            Label:
                text: "Todo lo de FREE, además:"
                color: 0.85, 0.90, 0.96, 1
                font_size: sp(14)
                bold: True
                size_hint_y: None
                height: dp(28)
                halign: "left"
                text_size: self.size

            Label:
                text: "✓ Cálculos ilimitados\n✓ Sin límite de operaciones\n✓ Soporte para operaciones básicas\n✓ Acceso a la versión PRO"
                color: 0.55, 0.65, 0.78, 1
                font_size: sp(13)
                size_hint_y: None
                height: dp(100)
                halign: "left"
                valign: "top"
                text_size: self.size

            SmallButton:
                text: "Volver a calculadora"
                on_press: root.volver(self)


# =========================================================
# CONFIRMACIÓN
# =========================================================

<ConfirmacionScreen>:

    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        spacing: dp(18)
        padding: dp(28)

        Widget:
            size_hint_y: 0.15

        Label:
            text: "CASI PRO..."
            color: 0.90, 0.94, 0.98, 1
            font_size: sp(28)
            bold: True

        BoxLayout:
            size_hint_y: 0.40
            padding: dp(24)

            canvas.before:
                Color:
                    rgba: 0.10, 0.13, 0.19, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(20)]

            Label:
                id: mensaje
                text: ""
                color: 0.85, 0.90, 0.96, 1
                font_size: sp(18)
                bold: True
                halign: "center"
                valign: "middle"
                text_size: self.size

        PrimaryButton:
            text: "SUSCRIBIRME IGUAL"
            on_press: root.suscribirse(self)

        SmallButton:
            text: "Volver a los planes"
            on_press: root.volver(self)

        Widget:
            size_hint_y: 0.15