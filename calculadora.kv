#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp


<DarkButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.92, 0.95, 1, 1
    font_size: sp(19)
    bold: True
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: (0.105, 0.12, 0.16, 1) if self.state == "normal" else (0.15, 0.20, 0.28, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]


<OperatorButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.45, 0.78, 1, 1
    font_size: sp(22)
    bold: True
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: (0.08, 0.16, 0.24, 1) if self.state == "normal" else (0.12, 0.25, 0.38, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]


<EqualButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: sp(23)
    bold: True
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: (0.08, 0.52, 0.95, 1) if self.state == "normal" else (0.05, 0.40, 0.75, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]


<SmallButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.65, 0.70, 0.78, 1
    font_size: sp(12)
    bold: True
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: (0.10, 0.12, 0.16, 1) if self.state == "normal" else (0.16, 0.18, 0.23, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(13)]


<CalculadoraScreen>:

    canvas.before:
        Color:
            rgba: 0.035, 0.045, 0.06, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(24)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(42)

            Label:
                text: "CALCULADORA"
                color: 0.94, 0.96, 1, 1
                font_size: sp(22)
                bold: True
                text_size: self.size

            Label:
                text: "PRO"
                color: 0.25, 0.70, 1, 1
                font_size: sp(17)
                bold: True
                halign: "right"
                text_size: self.size

        Label:
            text: "Calculadora básica"
            color: 0.45, 0.50, 0.58, 1
            font_size: sp(12)
            size_hint_y: None
            height: dp(22)
            text_size: self.size

        BoxLayout:
            size_hint_y: 0.23
            padding: dp(16)

            canvas.before:
                Color:
                    rgba: 0.075, 0.09, 0.12, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(22)]

            Label:
                id: display
                text: "0"
                color: 0.96, 0.98, 1, 1
                font_size: sp(38)
                bold: True
                halign: "right"
                valign: "middle"
                text_size: self.size

        GridLayout:
            rows: 5
            cols: 4
            spacing: dp(7)

            SmallButton:
                text: "AC"
                on_press: root.presionar_boton(self)

            SmallButton:
                text: "C"
                on_press: root.presionar_boton(self)

            OperatorButton:
                text: "%"
                on_press: root.presionar_boton(self)

            OperatorButton:
                text: "÷"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "7"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "8"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "9"
                on_press: root.presionar_boton(self)

            OperatorButton:
                text: "×"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "4"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "5"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "6"
                on_press: root.presionar_boton(self)

            OperatorButton:
                text: "-"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "1"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "2"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "3"
                on_press: root.presionar_boton(self)

            OperatorButton:
                text: "+"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "0"
                on_press: root.presionar_boton(self)

            DarkButton:
                text: "."
                on_press: root.presionar_boton(self)

            SmallButton:
                text: "Cambiar"
                on_press: root.presionar_boton(self)

            EqualButton:
                text: "="
                on_press: root.presionar_boton(self)


<FormularioScreen>:

    canvas.before:
        Color:
            rgba: 0.035, 0.045, 0.06, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        spacing: dp(16)
        padding: dp(28)

        Label:
            text: "SUMA RÁPIDA"
            color: 0.94, 0.96, 1, 1
            font_size: sp(30)
            bold: True
            size_hint_y: None
            height: dp(60)

        Label:
            text: "Una segunda interfaz usando BoxLayout"
            color: 0.55, 0.60, 0.68, 1
            font_size: sp(14)
            size_hint_y: None
            height: dp(35)

        TextInput:
            id: numero1
            hint_text: "Primer número"
            multiline: False
            input_filter: "float"
            font_size: sp(20)
            size_hint_y: None
            height: dp(58)
            padding: dp(16), dp(12)

        TextInput:
            id: numero2
            hint_text: "Segundo número"
            multiline: False
            input_filter: "float"
            font_size: sp(20)
            size_hint_y: None
            height: dp(58)
            padding: dp(16), dp(12)

        Button:
            text: "CALCULAR SUMA"
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: sp(17)
            bold: True
            size_hint_y: None
            height: dp(58)
            canvas.before:
                Color:
                    rgba: (0.08, 0.52, 0.95, 1) if self.state == "normal" else (0.05, 0.40, 0.75, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(18)]
            on_press: root.calcular_suma(self)

        Label:
            id: resultado
            text: "Resultado: 0"
            color: 0.25, 0.70, 1, 1
            font_size: sp(25)
            bold: True

        SmallButton:
            text: "Volver a calculadora"
            on_press: root.volver(self)
